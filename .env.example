# Optional AI framework. Set these in Tide's launch environment.
# Tide does not automatically load this file. Leave empty for local cover palettes.
TIDE_AI_PROVIDER=openai-compatible
TIDE_AI_ENDPOINT=
TIDE_AI_MODEL=
TIDE_AI_KEY=
# Gemini: provider=gemini; endpoint=https://generativelanguage.googleapis.com/v1beta
# Local compatible server: endpoint=http://127.0.0.1:PORT/v1; model=YOUR_MODEL
# Never commit real credentials.
