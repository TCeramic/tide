{
  "name": "tide",
  "version": "1.1.4",
  "private": true,
  "description": "潮汐 Tide — a personal, unofficial desktop music player",
  "main": "dist/main.js",
  "license": "GPL-3.0-only",
  "author": "TCeramic",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win zip --x64",
    "dist:setup": "npm run build && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "verify:design-systems": "node scripts/verify-design-systems.mjs",
    "test:ui": "node scripts/redesign-ui-smoke.cjs",
    "test:mini": "node scripts/redesign-native-smoke.cjs",
    "test:search:live": "node scripts/live-search-smoke.cjs",
    "test:perf": "node scripts/perf-smoke.cjs",
    "test:playback": "node scripts/playback-host-smoke.cjs",
    "test:native": "node scripts/native-smoke.cjs",
    "test:cursor": "node scripts/cursor-hold-smoke.cjs",
    "test:refresh": "node scripts/high-refresh-smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@chenglou/pretext": "1.0.0",
    "@paper-design/shaders": "0.0.81",
    "fast-xml-parser": "5.11.2",
    "lucide": "1.57.0",
    "lucide-react": "1.48.0",
    "NeteaseCloudMusicApi": "4.32.0",
    "pixi.js": "8.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "build": {
    "appId": "dev.tceramic.tide",
    "productName": "Tide",
    "executableName": "Tide",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "include": "build/installer.nsh",
      "artifactName": "Tide-Setup-${version}-${arch}.${ext}",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tide",
      "runAfterFinish": true
    }
  }
}
